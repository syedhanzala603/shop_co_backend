# ==========================================
# Shop-Co E-Commerce Backend Environment Variables
# ==========================================

# Server Port (Default is 3000 for AI Studio / local dev)
PORT=3000

# Node Environment ('development' | 'production')
NODE_ENV=development

# MongoDB Atlas Connection String
# 1. Sign up / Log in to MongoDB Atlas: https://www.mongodb.com/cloud/atlas
# 2. Create a Free Cluster (M0)
# 3. Create a Database User with username & password (e.g. admin / yourpassword)
# 4. Under Network Access, whitelist IP 0.0.0.0/0 (allow access from anywhere)
# 5. Click 'Connect' -> 'Drivers' -> Node.js and copy the connection string:
# Replace <username>, <password>, and specify database name like /shopco
MONGODB_URI=mongodb+srv://<username>:<password>@cluster0.abcde.mongodb.net/shopco?retryWrites=true&w=majority&appName=Cluster0

# Allowed CORS Origins (comma separated list of frontend URLs)
# Includes your Customer Website and Admin Dashboard on Vercel:
CORS_ORIGIN=https://shop-co-assignment.vercel.app,https://shop-co-assignment-dashbord.vercel.app,http://localhost:3000,http://localhost:5173,http://localhost:3001

# Admin Account Seed Credentials (Used by `npm run seed:admin`)
# Provide your desired admin email & password here, then run: npm run seed:admin
ADMIN_EMAIL=admin@shopco.com
ADMIN_PASSWORD=your_secure_admin_password

# JWT Authentication Security
JWT_SECRET=your_super_secret_jwt_key_change_in_production
JWT_EXPIRES_IN=7d

# AI Studio runtime variables (auto-injected if present)
GEMINI_API_KEY=MY_GEMINI_API_KEY
APP_URL=MY_APP_URL
MONGODB_URI = mongodb+srv://<db_username>:wrHBYw4lm9wJWFYE@cluster0.hzuvqww.mongodb.net/
JWT_SECRET = 5ec7d5ca9b6b513039a0d1c4ea094ee3f7ed43c7ad25ab104e7cb04b0d97575d
ADMIN_EMAIL= syedhanzalanadeem45@gmail.com
ADMIN_PASSWORD = hanzalashah
